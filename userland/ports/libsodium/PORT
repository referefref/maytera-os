# mports recipe: libsodium 1.0.20. The last item of the 2026-09 library-ports
# batch, deferred until now because it is the one library that CANNOT be shipped
# without a real userland entropy source: sodium_init() and every key/nonce it
# produces must draw from a CSPRNG. That prerequisite now exists (SYS_GETRANDOM
# -> kernel crypto/csprng.c, landed just before this port), so libsodium's RNG
# is wired to it and the fail-closed rule is satisfiable.
#
# libsodium is the modern userland crypto library: authenticated encryption
# (crypto_secretbox / crypto_box, XSalsa20-Poly1305 + X25519), signatures
# (crypto_sign, Ed25519), hashing, KDFs. It is the sane default for any userland
# app that needs crypto, in place of hand-rolled primitives.
#
# Read docs/MPORTS.md for what each key means. Every key here is DATA; the only
# executable part is ports/libsodium/build.sh (see its header for why this is
# build=script and not build=objects) plus ports/libsodium/randombytes_maytera.c
# (our RNG backend, a MayteraOS-authored TU, not upstream code).

name=libsodium
version=1.0.20

# CLASS A ("pure computation, no OS surface beyond memory"). libsodium computes
# over caller-owned buffers with a caller-replaceable allocator; the ONE OS
# dependency is entropy, and that is satisfied through our getrandom() wrapper
# (SYS_GETRANDOM), not through any file, socket, process or window. No filesystem
# surface, so not even class B.
class=A
homepage=https://libsodium.org/

# Official GitHub release tarball. sha256 MEASURED on the build container, not copied from a
# web page:
#   sha256sum libsodium-1.0.20.tar.gz
#   -> ebb65ef6ca439333c2bb41a0c1990587288da07f6c7fd07cb3a18cc18d30ce19
# 1.0.20 (2024) is the current stable release. The release tarball ships the
# pre-generated configure and all reference C sources; no autotools run is needed
# to build the portable library (version.h is the one generated header, produced
# from version.h.in as DATA in build.sh).
source_url=https://download.libsodium.org/libsodium/releases/libsodium-1.0.20.tar.gz
tarball=libsodium-1.0.20.tar.gz
sha256=ebb65ef6ca439333c2bb41a0c1990587288da07f6c7fd07cb3a18cc18d30ce19
srcdir=libsodium-1.0.20

# ISC licence (permissive, BSD-family; confirmed at build from the LICENSE file
# at the tarball root, whose text is an ISC grant, Copyright 2013-2024 Frank
# Denis). Reproduced in full in ATTRIBUTION.md.
licence=ISC
licence_files=LICENSE
copyleft=none

# THE ADOPTION TEST (owner rule 2): does this want to USE a platform layer, or to
# BE one? USES. libsodium is an embeddable library: the host owns main(), the
# process and (via sodium's own allocator wrappers) the heap; libsodium computes
# over buffers the caller provides. Its single environmental need is randomness,
# which it obtains through a REPLACEABLE randombytes_implementation, i.e. through
# a platform hook it consumes rather than a platform it imposes. It brings no
# event loop, no main() and no window system.
adoption=USES. libsodium is an embeddable crypto library; the host owns main(), the process and the allocator, and libsodium computes over caller-owned buffers. Its only environmental dependency is entropy, taken through the replaceable randombytes_implementation hook (here wired to our getrandom()/kernel CSPRNG), which is a platform layer it CONSUMES, not one it imposes.

# libc is the shared platform library, not a port. This port needed the
# getrandom()/getentropy() accessor (userland/libc/sys/random.c), which was added
# to the shared libc as SYS_GETRANDOM in the same batch and is useful to any
# future port, not forked here. No other libc addition was required.
needs=libc

# version.h is generated by build.sh from version.h.in (there is no configure
# step to copy a file into place), so there is no prepare copy.
prepare=none

# No patches. libsodium ships byte-for-byte unaltered. The MayteraOS adaptation
# is entirely (a) building the PORTABLE reference set with no SIMD HAVE_* macros
# (see build.sh) and (b) compiling ports/libsodium/randombytes_maytera.c in place
# of upstream's sysrandom TU to source entropy from our kernel CSPRNG. Neither is
# an edit to an upstream file, so there is no patch series to rot at a version
# bump.
patches=none

# build=script: ports/libsodium/build.sh generates version.h, compiles the
# portable reference set (SIMD variants skipped), swaps in our randombytes
# backend, archives libsodium.a and installs the nested sodium/ header tree.
build=script

# -DCONFIGURED=1 silences libsodium's "undocumented build method" warning (we DID
# configure it, as DATA in build.sh, just not via autotools). No SIMD HAVE_*
# macros and no HAVE_TI_MODE: the pure portable path, one uniform C build.
cflags=-DCONFIGURED=1

# mports copies the top-level umbrella header; build.sh installs the nested
# sodium/ tree (crypto_*.h, randombytes*.h, version.h, ...) that <sodium.h>
# includes.
headers=src/libsodium/include/sodium.h

lib=libsodium.a

# Proven with nm against the built archive (docs/MPORTS.md: symbols= is the
# anti-no-op check). Covers init, the RNG, and each crypto family the smoke test
# exercises, plus randombytes_sysrandom_implementation (our RNG backend struct,
# which is what makes the kernel CSPRNG the DEFAULT source).
symbols=sodium_init sodium_version_string randombytes_buf randombytes_random crypto_secretbox_easy crypto_secretbox_open_easy crypto_box_easy crypto_box_open_easy crypto_box_keypair crypto_sign_keypair crypto_sign crypto_sign_open crypto_sign_detached crypto_sign_verify_detached randombytes_sysrandom_implementation
