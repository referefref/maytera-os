exclude=libarchive/archive_disk_acl_darwin.c libarchive/archive_disk_acl_freebsd.c libarchive/archive_disk_acl_linux.c libarchive/archive_disk_acl_sunos.c libarchive/archive_read_disk_entry_from_file.c libarchive/archive_read_disk_posix.c libarchive/archive_read_disk_set_standard_lookup.c libarchive/archive_read_disk_windows.c libarchive/archive_read_extract.c libarchive/archive_read_extract2.c libarchive/archive_windows.c libarchive/archive_write_disk_posix.c libarchive/archive_write_disk_set_standard_lookup.c libarchive/archive_write_disk_windows.c libarchive/filter_fork_windows.c
exclude_reason=Not built. The *_windows.c files are the Win32 backend. The read_disk_*/write_disk_* files (and archive_read_extract/extract2, which drive write_disk) walk and mutate the REAL filesystem - opendir/fstatat, and mknod/chown/symlink/lchown/mkfifo/futimens for extraction - which is heavy OS surface userland/libc does not yet expose; the READ-into-memory path this port targets does not need them, and extract-to-disk is a documented follow-up. The archive_disk_acl_*.c files apply on-disk ACLs and belong to that same excluded disk path (archive_acl.c, the in-archive ACL metadata, IS built). Excluding these leaves the archive with zero unresolved symbols; nothing built references them.

# archive.h and archive_entry.h are the two public headers a consumer includes.
headers=libarchive/archive.h libarchive/archive_entry.h
lib=libarchive.a

# THE ANTI-NO-OP CHECK. Each name was read out of the built archive with nm.
# The read API proper (new/open/next_header/data/free), the format registrations
# (tar/cpio/zip/7zip/ar/iso9660/raw/empty + the "all" dispatcher), the filter
# registrations that actually work (gzip via zlib, compress/.Z, none), the entry
# accessors, a representative slice of the write API, and the error/version
# helpers. archive_read_support_format_xar and archive_read_support_filter_program
# are listed ON PURPOSE: they are the honest stubs, and requiring them proves
# those translation units were really compiled rather than silently dropped.
symbols=archive_read_new archive_read_support_format_all archive_read_support_format_tar archive_read_support_format_cpio archive_read_support_format_zip archive_read_support_format_7zip archive_read_support_format_ar archive_read_support_format_iso9660 archive_read_support_format_raw archive_read_support_format_empty archive_read_support_format_xar archive_read_support_filter_all archive_read_support_filter_gzip archive_read_support_filter_compress archive_read_support_filter_none archive_read_support_filter_program archive_read_open_filename archive_read_open_memory archive_read_next_header archive_read_data archive_read_data_block archive_read_close archive_read_free archive_entry_new archive_entry_free archive_entry_pathname archive_entry_size archive_entry_filetype archive_entry_mtime archive_write_new archive_write_set_format_ustar archive_write_set_format_pax archive_write_set_format_zip archive_write_set_format_cpio archive_write_add_filter_gzip archive_write_open_filename archive_write_header archive_write_data archive_write_free archive_error_string archive_errno archive_version_string
