# mports recipe: musl's POSIX regex (TRE-derived), MIT.
#
# WHY THIS PORT EXISTS, AND WHY IT IS NOT PCRE2. MayteraOS links LGPL-3.0
# GNU regex into two SHIPPED binaries, /APPS/GREP (GNU grep 2.5.4) and
# /APPS/VI (busybox vi), each with its own private copy of regex.c. The PCRE2
# port (userland/ports/pcre2) was expected to retire them and measurably
# cannot: 11 of 24 cases diverge, because PCRE is leftmost-FIRST where POSIX is
# leftmost-LONGEST, and because PCRE2 has no BRE mode at all. See blame.md
# "PCRE2 CANNOT DROP INTO GNU grep". musl's regex is leftmost-longest POSIX
# BRE and ERE, so it is a SEMANTIC drop-in. PCRE2 stays in the tree for a
# future `grep -P` and for new first-party consumers.
#
# THE CONSUMER LIST, KEPT CURRENT ON PURPOSE (#745 local 103). The paragraph
# above is about why this port EXISTS and names the two binaries whose LGPLv3
# copies it retired. It is not the list of who links libregex.a, and a stale
# consumer count is a defect this tree keeps recording. Today the archive is
# linked by THREE shipped binaries: /APPS/GREP and /APPS/VI, which use both the
# POSIX API and the GNU adapter that patch 0004 adds, and /APPS/SED, which uses
# only the POSIX regcomp/regexec surface. sed was 126 lines of memcmp() with no
# regex at all until local 103; it is the third consumer and it added no fourth
# copy of anything, which is the whole point of this mechanism.
#
# Read docs/MPORTS.md for what each key means. Every key here is DATA.

name=musl-regex
version=1.2.5
class=A
homepage=https://musl.libc.org/

# The official release tarball. The sha256 below is of THIS file and was
# MEASURED on the build container with sha256sum, not copied from a web page:
#   wget -O musl-1.2.5.tar.gz https://musl.libc.org/releases/musl-1.2.5.tar.gz
#   sha256sum musl-1.2.5.tar.gz
#   -> a9a118bbe84d8764da0ea0d28b3ab3fae8477fc7e4085d90102b8596fc7c75e4  (1,080,786 bytes)
source_url=https://musl.libc.org/releases/musl-1.2.5.tar.gz
tarball=musl-1.2.5.tar.gz
sha256=a9a118bbe84d8764da0ea0d28b3ab3fae8477fc7e4085d90102b8596fc7c75e4
srcdir=musl-1.2.5

# musl as a whole is MIT, stated in COPYRIGHT, which also records that the
# regex files specifically came from TRE under a 2-clause BSD licence and were
# relicensed MIT for musl by their author. Both texts are in COPYRIGHT, which
# is why that one file discharges the notice for everything built here, and
# both are reproduced verbatim in ATTRIBUTION.md. This string must equal the
# components.tsv row exactly or the attribution gate fails.
licence=MIT
licence_files=COPYRIGHT
copyleft=none

# THE ADOPTION TEST (owner rule 2): does this library want to USE a platform
# layer, or to BE one? MEASURED, not assumed: the produced archive leaves
# undefined only malloc/calloc/realloc/free, memcpy/memcmp/memset/memmove,
# strlen/strcmp, snprintf, the <ctype.h> predicates reached through the new
# wide-character layer, and the stack-protector globals. No filesystem, no
# process model, no event loop, no main(), no threads: it compiles a pattern
# into a caller-owned regex_t and matches bytes in a caller-owned buffer. It
# USES. Note the one thing it wanted that this userland did not have, wchar_t
# classification, went into the SHARED libc (userland/libc/wchar.h, wctype.h,
# wctype.c) per owner rule 1, not into a private shim here.
adoption=USES. Compiles a pattern into a caller-owned regex_t and matches bytes in a caller-owned buffer; owns no process, no I/O and no event loop. Its only platform demands are malloc/free, the string functions and character classification, all of which are in userland/libc.

needs=libc

# THE PRE-CONFIGURE STEP. musl's public <regex.h> lives in include/, and its
# regex sources reach it as <regex.h>. We cannot put include/ on the header
# path: it is a WHOLE ALTERNATIVE LIBC, and -Iinclude makes musl's stddef.h,
# string.h, stdlib.h and limits.h shadow MayteraOS's own, which is how the
# first attempt failed (musl's stddef.h includes bits/alltypes.h, which is
# generated by musl's configure and does not exist in the tarball). Copying
# the ONE header we want next to the sources gives a directory containing
# exactly regex.h and tre.h, which is what cflags puts on the angle-bracket
# path. It also means patch 0001 edits the copy, so include/regex.h stays
# pristine and the diff is against upstream's own file.
prepare=include/regex.h:src/regex/regex.h

# 0001 makes the header freestanding-safe (musl reaches its typedefs through
#      its private <features.h>/<bits/alltypes.h>), appends the GNU-compat
#      fields to struct re_pattern_buffer, and declares REG_STARTEND.
# 0002 supplies `hidden` (musl's private features.h) and drops regerror's
#      message-catalogue lookup, which lives in musl's private locale_impl.h.
# 0003 implements REG_STARTEND in the regexec wrapper: busybox vi's
#      :substitute requires it and upstream's matchers stop at a NUL.
# 0004 ADDS the two files that make this port a drop-in for GNU regex:
#      gnuregex.h and gnu_compat.c, the re_compile_pattern/re_search/re_match/
#      re_set_syntax layer that GNU grep's search.c and busybox vi both call
#      alongside the POSIX API. ONE copy, linked by both consumers.
# 0005 accepts \1..\9 as back references in ERE as well as BRE. Upstream
#      allows them only in BRE, because POSIX leaves them undefined in ERE;
#      GNU grep accepts them in both, and `grep -E '(ab)\1'` measurably
#      returned NOMATCH here before this one-line change. That measurement is
#      in tools/pcre2-oracle/divergence.py, which is why the change is a
#      recorded finding and not a guess.
patches=0001-regex-h-freestanding-gnu-fields-startend.patch 0002-tre-h-hidden-and-regerror-no-locale.patch 0003-regexec-reg-startend.patch 0004-gnu-regex-api-adapter.patch 0005-backrefs-in-ere.patch

build=objects

# The four upstream translation units that ARE the regex engine, plus our
# adapter. Not a glob of src/regex/*.c: that would sweep in fnmatch.c and
# glob.c, which are different POSIX APIs with their own libc entanglements
# (glob.c wants opendir/readdir/stat) and are not what this port promises.
sources=src/regex/regcomp.c src/regex/regexec.c src/regex/regerror.c src/regex/tre-mem.c src/regex/gnu_compat.c

exclude=src/regex/fnmatch.c src/regex/glob.c
exclude_reason=Different APIs that merely share the directory. fnmatch() is shell-style globbing, not regex, and GNU grep already ships its own gnulib fnmatch that its -f/--exclude paths are written against; adding a second definition of the same name would collide at link time in exactly the binary this port is meant to simplify. glob() additionally needs opendir/readdir/stat and a working relative-path model, which is the same gap that kept zlib's gz* layer out (see that recipe).

# -Isrc/regex is the whole reason for the prepare step above: it is a
# directory containing regex.h, tre.h, gnuregex.h and the sources, and
# nothing else, so upstream's <regex.h> resolves without musl's other headers
# shadowing MayteraOS's. -Wno-sign-compare because upstream compares wint_t
# against int in four places and builds with its own warning set; this is
# vendored code we do not intend to fix, and a wall of warnings is how a real
# one gets missed.
cflags=-Isrc/regex -Wno-sign-compare -Wno-implicit-fallthrough

headers=src/regex/regex.h src/regex/gnuregex.h
lib=libregex.a

# THE ANTI-NO-OP CHECK. mports.sh proves with nm that every one of these is a
# DEFINED symbol in libregex.a. The first four are the POSIX API. The last
# five are the GNU API that patch 0004 adds, and listing them is what makes
# that patch load-bearing: if it ever stops applying, this line fails the
# build instead of silently shipping an archive that grep and vi cannot link.
symbols=regcomp regexec regfree regerror re_compile_pattern re_search re_match re_set_syntax re_syntax_options
