# mports recipe: zlib. Recipe number one, per
# docs/PORTABILITY_HOMEBREW_SNAPCRAFT_ASSESSMENT.md section 12 next-action 4.
#
# Read docs/MPORTS.md for what each key means. Every key here is DATA: there is
# no zlib-specific script anywhere in the tree, and mports.sh has no idea what
# zlib is.

name=zlib
version=1.3.1
class=A
homepage=https://zlib.net/

# The GitHub release asset, not zlib.net: zlib.net serves a plain wget a 403,
# and a source you cannot fetch non-interactively is not a pin. The sha256
# below is of THIS file and was measured, not copied from a web page.
source_url=https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz
tarball=zlib-1.3.1.tar.gz
sha256=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
srcdir=zlib-1.3.1

licence=Zlib
licence_files=LICENSE
copyleft=none

# THE ADOPTION TEST (owner rule 2): does this library want to USE a platform
# layer, or to BE one? zlib USES. It is pure computation over caller-supplied
# buffers; the only platform surface the files we build touch is malloc/free
# (through the caller-replaceable zalloc/zfree hooks) and memcpy/memset. It
# imposes no event loop, no main(), no window system and no filesystem model.
adoption=USES. Pure buffer-in/buffer-out computation; the only platform surface is malloc/free via the caller-replaceable zalloc/zfree hooks. It never wants to own the process.

needs=libc

prepare=none
patches=none

build=objects

# The eleven core translation units, i.e. an upstream zlib MINUS its stdio file
# wrapper. This is upstream's own division: gz*.c is the "gzFile" convenience
# layer over FILE*, and everything the zlib API proper offers (deflate/inflate,
# compress/uncompress, crc32/adler32) lives in the files below.
sources=adler32.c compress.c crc32.c deflate.c infback.c inffast.c inflate.c inftrees.c trees.c uncompr.c zutil.c

exclude=gzclose.c gzlib.c gzread.c gzwrite.c
exclude_reason=The gzFile layer wants vsnprintf/snprintf-into-a-path, open/read/write/lseek on a cwd-relative path, and errno strings. Two of those three are exactly the gaps recorded in PORTABILITY_HOMEBREW_SNAPCRAFT_ASSESSMENT.md sections 2.2 and 2.4 (no relative-path resolution anywhere in the kernel). Shipping a gzopen() that silently opens the wrong path is worse than not shipping one, so it is EXCLUDED BY NAME here rather than left to fail at link time in some future consumer. Revisit when the cwd chokepoint lands.

# -DZ_SOLO is NOT set: we do have malloc/free, so zlib's default zalloc/zfree
# are correct and compress()/uncompress() work without the caller supplying an
# allocator. -DNO_GZIP is NOT set either: the raw DEFLATE and gzip-wrapper
# stream formats are in deflate.c/inflate.c, not in the excluded gz*.c files,
# so windowBits +16/-15 still work.
cflags=-DHAVE_HIDDEN

headers=zlib.h zconf.h
lib=libz.a

# THE ANTI-NO-OP CHECK. mports.sh proves with nm that every one of these is a
# DEFINED symbol in libz.a. An archive that compiled out of the wrong file
# list, or with the API #ifdef'd away, fails here instead of failing silently
# in a consumer six weeks later.
symbols=zlibVersion deflate deflateInit_ deflateInit2_ deflateEnd deflateBound inflate inflateInit_ inflateInit2_ inflateEnd compress compress2 compressBound uncompress crc32 adler32
