# -DUSE_GCU: build the ncurses/GCU frontend only (main-gcu.o); the modules[]
#   table in main.c then has exactly one entry, "gcu", so main() selects it
#   with no -m flag needed. X11/SDL/SDL2/stats/spoil/win are all left
#   unbuilt (not in `sources=` at all): this OS has none of those toolkits
#   (docs/PORTABILITY_HOMEBREW_SNAPCRAFT_ASSESSMENT.md section 2.6).
# -DALLOW_BORG: upstream's own Makefile.std default (BORG_FLAGS). The borg/*.c
#   files are unconditionally part of ANGFILES0 either way (they compile with
#   or without this macro); it only gates whether the in-game "activate the
#   Borg autoplayer" wizard command is reachable. Left matching upstream
#   default rather than silently narrowing behaviour with no OS-specific
#   reason to.
# -DUSE_PRIVATE_PATHS, -DDEFAULT_CONFIG_PATH/-DDEFAULT_LIB_PATH/
#   -DDEFAULT_DATA_PATH: see the port header above (runtime data path).
cflags=-Isrc -DUSE_GCU -DALLOW_BORG -DUSE_PRIVATE_PATHS -DPRIVATE_USER_PATH="/GAMES/ANGBAND" -DDEFAULT_CONFIG_PATH="/ANGBAND/" -DDEFAULT_LIB_PATH="/ANGBAND/" -DDEFAULT_DATA_PATH="/ANGBAND/"

# A program installs no public header, like darkhttpd (the headers=none

# THE RUNTIME DATA PATH (see the port header comment above). Angband's own
# lib/ tree has FOUR directories a text/GCU build actually reads: gamedata
# (object/monster/spell/vault definitions, 1.3M/46 files), customize
# (default .prf colour/keymap/option files, 68K/12 files), help (in-game
# help text, 32K/6 files) and screens (splash/death ASCII art, 24K/5 files).
# fonts/tiles/sounds/icons (~24MB combined) are SDL/win-frontend-only assets
# this build never opens (-DUSE_GCU, no USE_GRAPHICS/SOUND) and lib/user is
# upstream's own optional sample override content, unrelated to our real
# real save path (/GAMES/ANGBAND, see USE_PRIVATE_PATHS above); both are
# deliberately left off the image. build/build-golden.sh overlays
# /data/angband/* onto ext2 /ANGBAND/*, parallel to the existing
# /TERMINFO overlay for the ncurses port.
install_data=lib/gamedata:angband/gamedata lib/customize:angband/customize lib/help:angband/help lib/screens:angband/screens
# literal).
headers=none

# THE PRIMARY LIBRARY. Same shape as darkhttpd: main() lives inside this
# archive (from main.c), and it exists to be linked by exactly ONE consumer,
# userland/apps/angband, which pulls main() out of it via crt0.
lib=libangband.a

# THE ANTI-NO-OP CHECK. `main` proves main.c compiled with a real entry
# point; `init_gcu` proves the GCU frontend module compiled and is the one
# main.c's modules[] table will select; `play_game` proves the actual game
# loop (game-world.c/ui-game.c) is in the archive, not stubbed; `quit` proves
# z-util.c's core error/exit path is present (nearly everything calls it);
# `mvwaddnwstr` proves patches/0001 actually applied (a patch that silently
# stopped applying would otherwise ship a binary that fails to LINK, but
# checking the symbol here catches it even if some other code path happened
# to satisfy the link some other way). Measured with `nm --defined-only` on
# the compiled objects before this recipe was written.
symbols=main init_gcu play_game quit mvwaddnwstr
