# MayteraOS GUI Terminal - terminfo description (ticket #745, mports ncurses)
#
# This entry is written to match the emulator in
# userland/apps/terminal/term_parse.c + term_emu.c and the key encoding in
# term_pty.c EXACTLY. It deliberately does NOT claim capabilities the emulator
# does not implement:
#   - No xenl: the emulator wraps IMMEDIATELY at the right margin (term_put_cp),
#     it has no VT100 deferred-wrap "magic margin".
#   - No smir/rmir (insert mode): CSI 4h/4l (IRM) is NOT modelled; character
#     insertion is done with ich/ich1 (CSI @), which IS modelled.
#   - No flash: DECSCNM (CSI ?5h) is not modelled.
#   - No function keys (kf1..): term_pty.c does not emit them.
# The arrow / navigation keys are the CSI forms the pty actually sends, NOT the
# application-cursor-key (SS3 / ESC O) forms, because term_pty.c always sends
# ESC [ A regardless of DECCKM.
#
# Line drawing (smacs/rmacs/acsc) IS honest: term_parse.c maps the DEC special
# graphics set to Unicode box-drawing at print time (added for #745).
#
# THE PRIMARY NAME IS maytera-256color: that is the exact string the Terminal
# exports as TERM to every child (userland/apps/terminal/main.c:97), so it is the
# name ncurses actually looks up. `maytera` is kept as an alias for anyone who
# sets it by hand, and the patched compiled-in default (lib_setup.c) is "maytera",
# which also resolves here.
maytera-256color|maytera|MayteraOS GUI terminal (xterm-class, 256 color),
	am, msgr,
	colors#0x100, cols#80, it#8, lines#24, pairs#0x7fff,
	acsc=``aaffggiijjkkllmmnnooppqqrrssttuuvvwwxxyyzz{{||}}~~,
	bel=^G, blink=\E[5m, bold=\E[1m, cbt=\E[Z, civis=\E[?25l,
	clear=\E[H\E[2J, cnorm=\E[?25h, cr=\r,
	csr=\E[%i%p1%d;%p2%dr, cub=\E[%p1%dD, cub1=^H, cud=\E[%p1%dB,
	cud1=\n, cuf=\E[%p1%dC, cuf1=\E[C, cup=\E[%i%p1%d;%p2%dH,
	cuu=\E[%p1%dA, cuu1=\E[A, dch=\E[%p1%dP, dch1=\E[P, dim=\E[2m,
	dl=\E[%p1%dM, dl1=\E[M, ech=\E[%p1%dX, ed=\E[J, el=\E[K,
	el1=\E[1K, home=\E[H, hpa=\E[%i%p1%dG, ht=^I, hts=\EH,
	ich=\E[%p1%d@, il=\E[%p1%dL, il1=\E[L, ind=\n, indn=\E[%p1%dS,
	invis=\E[8m, kbs=\177, kcbt=\E[Z, kcub1=\E[D, kcud1=\E[B,
	kcuf1=\E[C, kcuu1=\E[A, kdch1=\E[3~, kend=\E[4~, khome=\E[1~,
	kich1=\E[2~, knp=\E[6~, kpp=\E[5~, op=\E[39;49m, rc=\E8,
	rev=\E[7m, ri=\EM, rin=\E[%p1%dT, rmacs=\E(B, rmam=\E[?7l,
	rmcup=\E[?1049l, rmso=\E[27m, rmul=\E[24m, rs1=\Ec, sc=\E7,
	setab=\E[%?%p1%{8}%<%t4%p1%d%e%p1%{16}%<%t10%p1%{8}%-%d%e48;5;%p1%d%;m,
	setaf=\E[%?%p1%{8}%<%t3%p1%d%e%p1%{16}%<%t9%p1%{8}%-%d%e38;5;%p1%d%;m,
	sgr0=\E[0m, smacs=\E(0, smam=\E[?7h, smcup=\E[?1049h,
	smso=\E[7m, smul=\E[4m, strikethrough=\E[9m, tbc=\E[3g,
	u6=\E[%i%p1%d;%p2%dR, u7=\E[6n, u8=\E[?%[;0123456789]c, u9=\E[c,
	vpa=\E[%i%p1%dd,

# Alias with an explicit 16-color view for software that keys off the name.
maytera-16color|MayteraOS GUI terminal (16 colors),
	colors#16, pairs#0x100, use=maytera,
