{
  "app": "sysmon",
  "version": "1.0.0",
  "description": "System Monitor: CPU/RAM/network history graphs, per-core load, sortable process table with signal control and priority editing",
  "icon": "sysmon.bmp",
  "category": "System",
  "capabilities": [
    {
      "action": "end_task",
      "parameters": {"pid": "int", "signal": "int"},
      "description": "Send SIGTERM or SIGKILL to a process",
      "requires_capability": "system.process.kill"
    },
    {
      "action": "set_priority",
      "parameters": {"pid": "int", "level": "int"},
      "description": "Set a process scheduling priority (1=low 2=normal 3=high)",
      "requires_capability": "system.process.priority"
    }
  ],
  "state_queries": [
    {
      "query": "get_processes",
      "returns": [{"pid": "int", "name": "string", "state": "string", "cpu": "int", "mem_kb": "int", "core": "int"}],
      "requires_capability": "system.process.read"
    },
    {
      "query": "get_performance",
      "returns": {"cpu_total": "int", "per_core": ["int"], "mem_total": "int", "mem_used": "int", "net_kbs": "int"},
      "requires_capability": "system.process.read"
    }
  ]
}
