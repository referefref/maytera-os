{
  "name": "Unit Converter",
  "version": "1.0.0",
  "binary": "convert",
  "icon": "calculator.bmp",
  "category": "Utilities",
  "description": "Convert between 49 units across length, mass, temperature, data, speed, time, area and volume",
  "capabilities": {
    "actions": [
      {
        "name": "convert",
        "description": "Convert a value between two units",
        "params": ["value", "from_unit", "to_unit"],
        "returns": "number",
        "requires": null
      }
    ],
    "queries": [
      {
        "name": "get_result",
        "description": "Get the current converted value",
        "returns": "number",
        "requires": null
      }
    ]
  },
  "window": {
    "default_width": 620,
    "default_height": 560,
    "resizable": true
  },
  "ipc_channels": []
}
