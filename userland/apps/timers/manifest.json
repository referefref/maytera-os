{
  "name": "Timers",
  "version": "1.0.0",
  "binary": "timers",
  "icon": "clock.bmp",
  "category": "Utilities",
  "description": "Stopwatch with laps, countdown timer with presets, and a pomodoro focus timer",
  "capabilities": {
    "actions": [
      {
        "name": "start_stopwatch",
        "description": "Start or resume the stopwatch",
        "params": [],
        "returns": "void",
        "requires": null
      },
      {
        "name": "start_timer",
        "description": "Start a countdown for the given number of seconds",
        "params": ["seconds"],
        "returns": "void",
        "requires": null
      }
    ],
    "queries": [
      {
        "name": "get_elapsed",
        "description": "Get current stopwatch elapsed milliseconds",
        "returns": "number",
        "requires": null
      }
    ]
  },
  "window": {
    "default_width": 430,
    "default_height": 540,
    "resizable": true
  },
  "ipc_channels": []
}
