{
  "app": "svcmgr",
  "version": "1.0.0",
  "description": "Services & Startup Manager: view/control #95 kernel services (SERVICES.CFG) and the boot startup application (AUTORUN.CFG)",
  "icon": "svcmgr.bmp",
  "category": "System",
  "capabilities": [
    {
      "action": "run_service",
      "parameters": {"name": "string"},
      "description": "Launch a service's ELF now via spawn",
      "requires_capability": "system.process.spawn"
    },
    {
      "action": "stop_service",
      "parameters": {"name": "string"},
      "description": "Send SIGTERM to a running service process",
      "requires_capability": "system.process.kill"
    },
    {
      "action": "set_service_flags",
      "parameters": {"name": "string", "enabled": "bool", "autostart": "bool"},
      "description": "Rewrite SERVICES.CFG (takes effect at next boot)",
      "requires_capability": "system.config.write"
    },
    {
      "action": "set_startup_app",
      "parameters": {"path": "string"},
      "description": "Write /CONFIG/AUTORUN.CFG (desktop launches it after boot)",
      "requires_capability": "system.config.write"
    }
  ],
  "state_queries": [
    {
      "query": "get_services",
      "returns": [{"name": "string", "exec": "string", "account": "string", "uid": "int", "perms": "string", "autostart": "bool", "enabled": "bool", "running_pid": "int"}],
      "requires_capability": "system.config.read"
    },
    {
      "query": "get_startup_app",
      "returns": {"path": "string"},
      "requires_capability": "system.config.read"
    }
  ]
}
