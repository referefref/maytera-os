proc/syscall.c:5624: if (vmm_alloc_user_pages(p->cr3, old_brk, pages, VMM_USER_RW) != 0) {
proc/syscall.c:5630: vmm_free_user_pages(p->cr3, new_brk, pages);
proc/syscall.c:5633: p->brk = new_brk;
proc/syscall.c:5572: process_t *p = proc_current();
proc/syscall.c:5605: if (!p || p->privilege != PRIV_USER) return -1;
proc/syscall.c:5660: if (!p->mm) p->mm = mm_create();
proc/syscall.c:5661: if (!p->mm) return -1;
proc/syscall.c:5687: uint64_t r = do_mmap((mm_struct_t *)p->mm, addr, len,
proc/syscall.c:5660: process_t *p = proc_current();
proc/syscall.c:5661: if (!p || p->privilege != PRIV_USER) {
proc/syscall.c:5719: if (p->mm) return do_munmap((mm_struct_t *)p->mm, addr, len);
proc/syscall.c:5722: vmm_free_user_pages(p->cr3, addr, pages);

[KNOWN_GAP]
# ONE entry, and it is a CLASS, not a site. Do not add anything else here to
# make a build pass: an entry here disarms CR4.SMAP for the WHOLE kernel (the
# Makefile interlock), which is a far larger regression than whatever site you
# were trying to land. Convert the site.
#
# THE BLOCKER: A RING-3 PATH STRING IS HANDED TO THE FILESYSTEM RAW.
# The syscall surface VALIDATES a path string (rustkern/argtab.rs declares it
# Kind::Str, security/validate.c walks it) and then passes the CALLER'S OWN
# Ring-3 pointer to the filesystem, which walks it again with plain Ring-0
# loads: fat_read_file's /SMB and /NFS prefix tests, the /ext2 and root-routing
# predicates in proc/syscall_path.h, ext2, fs/perms.c. Every one of those loads
# is a #PF once CR4.SMAP is set. MEASURED on an armed boot: RIP inside
# fat_read_file (fs/fat.c), CR2 in the user window, err=0x1 (present, read,
# supervisor), with RSI holding the Ring-3 path and RDI the kernel fat_fs_t.
#
# It is a class of HUNDREDS of loads across a dozen files, so bracketing them
# one at a time is not a fix, it is a list that goes stale. The fix is the
# shape: bounce each declared string into kernel memory ONCE, at the dispatcher,
# and rewrite the argument, so nothing downstream ever holds a Ring-3 string.
# That also closes the check-and-use race argtab.rs's own header asks for, and
# costs almost nothing, because validate_user_string() already walks every byte.
#
# THAT BOUNCE WAS BUILT, AND IT IS NOT IN THE TREE, BECAUSE IT REGRESSED THE
# DESKTOP AND THE CAUSE WAS NOT FOUND. With it in, the compositor started,
# mapped its framebuffer, read /CONFIG/LOGIN.CFG and then went idle at 0% CPU
# without drawing; the control (same commit, bounce removed) drew the full
# desktop. Two real bugs in it were found and fixed and did NOT explain the
# rest: strnlen_user() returns the length EXCLUDING the NUL (so a capacity of
# `need` silently truncated every path by one character), and the argtab
# validation must run BEFORE the bounce, not after (validating the kernel copy
# rejects it with -EFAULT). The leading unproven suspect for the residual is a
# descriptor that declares an OUT parameter as Kind::Str: bouncing one of those
# hands the handler a kernel buffer to fill and the caller never sees the
# result, silently. Whoever picks this up should start by auditing every s()
# entry in rustkern/argtab.rs for write-direction use, and should keep the
# `make SMAPTEST=1` negative control armed while doing it.
proc/syscall_path.h:47: return p && p[0]=='/' && p[1]=='e' && p[2]=='x' && p[3]=='t'
fs/fat.c:2519: if (path && (path[0]=='/') &&

# ---------------------------------------------------------------------------
# CONVERTED, and still UNDETECTABLE BY THIS LINT - hand-maintained
# ---------------------------------------------------------------------------
# These were real unwrapped user accesses that no textual rule here can reach,
# because the user pointer arrives as a plain `void *buf` through a VFS
# function-pointer table (f->ops->read/write) or a driver op, with nothing in
# the callee naming it as user memory. They are all converted now. They stay
# listed, as prose, because the lint still cannot see them: if one of these
# brackets is deleted, NOTHING in the build will notice, and this list is the
# only pointer to where to look.
#
#   fs/fat.c fat_read_inner()/fat_write_inner()   - the two cluster memcpys
#   fs/fat_vfs.c fat_file_write()                 - the g_wbuf fill loop
#   fs/ext2_vfs.c e2v_read()/e2v_write()          - the two buffer memcpys
#   fs/pipe.c pipe_read_fn()/pipe_write_fn()      - the two byte loops
#   proc/fdlayer.c sys_read()                     - the SMB, ext2-rw and
#                                                   ext2-window memcpys
#   drivers/tty.c tty_read()/tty_write()/tty_output_drain()
#   drivers/dev.c devzero_read()/devurandom_read()/devurandom_write()
#   drivers/console.c console_write()             - the kputc loop and the
#                                                   syslog mirror memcpy
#   drivers/usb_cdc_acm.c usb_cdc_acm_write()/usb_cdc_acm_read()
#   drivers/audio_pcm.c audio_pcm_write()         - the two ring memcpys ONLY,
#                                                   never the wait_event around
#                                                   them
#   gui/fb_syscall.c sys_fb_info/sys_get_mouse/sys_get_global_mouse/sys_get_key
#   gui/window.c sys_wm_get_windows()             - the whole row loop body
#   gui/theme.c sys_theme_get_name()              - copy_to_user (no dispatcher
#                                                   case exists for it today)
#   ipc/shm.c sys_shm_map()/sys_shm_info()        - the out-param stores
#   ipc/msg.c msg_queue_message()/msg_dequeue_message() - the payload memcpys;
#             sys_ipc_register_name()/sys_ipc_lookup_name() now bounce the
#             Ring-3 name once with strncpy_from_user
#   sync/futex.c futex_wait()/futex_cmp_requeue() - the `*addr` load ONLY; the
#             futex_wait bracket must stay inside the bucket lock and must not
#             span the wait
#   proc/syscall.c SYS_FONT_NAME / SYS_FONT_STYLE / SYS_FONT_FIND /
#             SYS_CLIP_SET / SYS_CLIP_GET / SYS_SSH_CLIENT / SYS_NET_INFO /
#             SYS_PROC_LIST / SYS_KERNEL_UPDATE and sc_copy_str_user()
#
# NOT a fault site, checked and cleared: net/socket.c (every user buffer already
# goes through copy_*_user), the net_cr3_* helpers (they switch TO the kernel
# CR3 and bounce payloads either side), exec/pe.c and the Win16 layer (kernel
# heap only), drivers/tty.c's tty_ioctl() handlers (proc/syscall.c bounces the
# ioctl arg through a kernel buffer at the SYS_IOCTL boundary; that clearance
# lasts only as long as tty_ioctl_user_desc() lists every cmd whose handler
# dereferences `arg`), fs/pipe.c pipe_create()'s pipefd[] (bounced at
# SYS_PIPE), fs/fat.c's readdir family (bounced at SYS_READDIR), ipc/shm.c's
# memset of the kernel direct-map alias in shm_create, gui/fb_syscall.c's
# sys_fb_flip (it copies under the kernel CR3, whose identity map is U/S=0, as
# the boot pre-flight probe measures), and all DMA (device DMA does not honour
# SMAP, and no driver hands a user VA to a TRB/PRD).