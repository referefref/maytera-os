    "<WORKSPACE>/",
]
# Small proc_sleep(N)/msleep(N) argument at or below this is treated as a poll.
SMALL_SLEEP_MS = 16

# Canonical blocking primitives. If a loop body uses one of these it is
# considered correctly routed and is NOT flagged as a spin.
BLOCKING_PRIMITIVES = [
    "wait_event", "wait_event_interruptible", "wait_event_timeout",
    "futex_wait", "sys_futex", "wake_up", "waitq_wait", "wq_wait",
    "sem_down", "sem_wait", "cond_wait", "block_on",
]

# Names (function or file basename) that identify a NO-BLOCK context in which
# ANY sleep/yield/block is a bug: IRQ/ISR handlers and the compositor draw
# thread. Kept deliberately narrow to avoid false positives.
NOBLOCK_FUNC_RE = re.compile(
    r"(?:^|_)(?:irq|isr)(?:$|_)"
    r"|(?:irq|isr|interrupt)_handler"
    r"|handle_(?:irq|isr|interrupt)"
    r"|on_draw\b|draw_thread\b|compositor_draw\b|draw_frame\b|_draw_cb\b",
    re.IGNORECASE,
)
NOBLOCK_CALLS = [
    "proc_sleep", "proc_yield", "msleep", "usleep",
    "wait_event", "futex_wait", "sem_down", "sem_wait",
]

# #514: calls that burn time WITHOUT ever yielding the CPU. A loop whose body
# is made of nothing but these is a pure hardware spin: it holds the core for
# the whole wait. This is the e1000_send() `for (i=0;i<1000;i++) io_wait();`
# / xhci_delay() class, which the old rule set missed entirely because the
# body was not EMPTY, it was full of delay calls.
DELAY_ONLY_CALLS = [
    "io_wait", "pause", "cpu_relax", "cpu_pause", "rep_nop",
    "udelay", "ndelay", "mdelay", "delay_us", "delay_ms",
    "__builtin_ia32_pause",
]
# Statements permitted alongside the delay calls in a "pure delay" body without
# making it something other than a spin (counters, breaks, kprintf tracing).
_PURE_DELAY_NOISE_RE = re.compile(
    r"\b(?:break|continue|;)\b|\+\+|--|^\s*$"
)

# #114 PRIVATE HAND-ROLLED SPINLOCKS.
#
# WHY THIS RULE EXISTS, MEASURED. #75 read a live two-core deadlock out of
# guest memory over QMP (six samples 30 s apart, all identical): mm/pmm.c had
# its own `volatile int` + test-and-set lock that never touched RFLAGS.IF. A
# core took it with IF=1 and WITHOUT the Big Kernel Lock, was interrupted, and
# cpu/idt.c wraps every ISR in bkl_acquire() - so the holder became a BKL
# WAITER WHILE STILL HOLDING ITS OWN LOCK. A second core inside a SYSCALL
# (which takes the BKL at entry) then wanted pmm_lock. AB-BA. Both cores spun
# with IF=1, neither halted, nothing recovered.
#
# THE POINT OF THE RULE, NOT THE FIX. mm/heap.c had the IDENTICAL defect and
# was fixed by #347. mm/pmm.c, IN THE SAME DIRECTORY, was not fixed at the same
# time, survived for months, and took a bespoke instrument plus a QMP memory
# dump to find again. Fixing instances does not stop the class; a build-time
# check does.
#
# Kernel-only by construction: RFLAGS.IF and the BKL exist only in Ring 0, so
# firing this rule on userland would be noise.
PRIVATE_LOCK_ACQUIRE = [
    # gcc legacy __sync builtins (the pmm/heap/demand/fat_readahead shape)
    "__sync_lock_test_and_set",
    "__sync_bool_compare_and_swap",
    "__sync_val_compare_and_swap",
    # gcc __atomic builtins. net/net_perf.c uses __atomic_test_and_set, and a
    # sweep that greps only for __sync_lock_test_and_set MISSES IT ENTIRELY.
    # That is exactly the "different builtin survives the targeted grep" hole.
    "__atomic_test_and_set",
    "__atomic_exchange",
    "__atomic_exchange_n",
    "__atomic_compare_exchange",
    "__atomic_compare_exchange_n",
    # our own shared atomics, used to hand-roll a lock rather than to take one
    "atomic_xchg32", "atomic_xchg64", "atomic_cas32", "atomic_cas64",
]
PRIVATE_LOCK_ACQUIRE_RE = re.compile(
    r"\b(?:" + "|".join(re.escape(a) for a in PRIVATE_LOCK_ACQUIRE) + r")\s*\("
)
# Raw inline asm that IS the acquire. Matched against the ORIGINAL source, not
# the comment/string-stripped copy, because these live inside asm string
# literals which strip_comments_and_strings() blanks out.
PRIVATE_LOCK_ASM_RE = re.compile(
    r"xchg[bwlq]?\s|lock\s+cmpxchg|lock\s+bts|lock\s+xchg"
)

# A loop that parks on the shared wait queue is CORRECTLY routed even though it
# contains an atomic acquire: that is the fs/fat.c fat_lock() and
# drivers/usb_msc.c msc_cmd_lock() shape (uncontended CAS fast path, then
# __wait_prepare + __wait_event_wait_deadline on contention). Deliberately a
# SEPARATE list from BLOCKING_PRIMITIVES: extending that shared list would
# change the verdict of the existing rules and re-fingerprint allowlist entries
# that have nothing to do with #114.
PARK_PRIMITIVES = BLOCKING_PRIMITIVES + [
    "__wait_prepare", "__wait_finish", "__wait_event_wait_deadline",
    "wake_up_all", "wq_may_block",
]

# Idioms that mask RFLAGS.IF for the duration of the hold. Checked against the
# RAW source of the enclosing function, because "cli" and "pushfq" only ever
# appear inside asm string literals.
IRQMASK_RE = re.compile(
    r"\bcli\b|pushfq|irqsave|irq_save|irqrestore|save_flags|local_irq"
    r"|irq_disable|disable_interrupts"
)


RULES = {
    "SPIN_BUSYWAIT": "Empty-bodied busy-wait loop (spins the CPU). Route the "
