    print(' B. GREEN on the fixed form and on the three provable root shapes:')
    ok &= run_case('routed call + literal + #define + snprintf-prefix + comment',
                   SELF_GREEN, 0)

    print(' C. the covered-function table still matches kernel/fs/fat.h:')
    fath = os.path.abspath(os.path.join(HERE, '..', '..', 'fs', 'fat.h'))
    if os.path.exists(fath):
        decl = set(re.findall(r'\b(fat_\w+)\s*\(\s*fat_fs_t \*fs,\s*const char \*',
