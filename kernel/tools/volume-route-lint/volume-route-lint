def run_justify_case(label, body, row_for, want_bad):
    """Write `body` as a one-file tree, fingerprint its single hit, build an
    allowlist row from `row_for(hit)`, and count contradictions."""
    global ALLOWLIST
    d = tempfile.mkdtemp(prefix='vrl-j-')
    os.makedirs(os.path.join(d, 'kernel', 'fs'))
    with open(os.path.join(d, 'kernel', 'fs', 'case.c'), 'w') as f:
        f.write(body)
    hits, _ = scan_tree(d, ['kernel'])
    if len(hits) != 1:
        print('  %-58s FAIL (fixture produced %d hits, expected 1)'
              % (label, len(hits)))
        return False
    allow_path = os.path.join(d, 'allowlist.txt')
    with open(allow_path, 'w') as f:
        f.write(row_for(hits[0]) + '\n')
    saved, ALLOWLIST = ALLOWLIST, allow_path
    try:
        bad = check_justifications(hits, load_allowlist(), d)
    finally:
        ALLOWLIST = saved
    verdict = 'PASS' if len(bad) == want_bad else 'FAIL'
    print('  %-58s bad=%d want=%d  %s' % (label, len(bad), want_bad, verdict))
    for _, _, why in bad:
        print('        -> %s' % why.split('\n')[0][:150])
    return len(bad) == want_bad


