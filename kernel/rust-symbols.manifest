# ---------------------------------------------------------------------------
# rustkern/guestfs.rs - #708: the identity a DOS or Win16 GUEST program's
# filesystem access is checked against. A guest runs inside a kernel thread and
# so has no credentials of its own; its identity is captured AT LAUNCH from the
# launcher (via the #692 resolver above), carried in a per-layer slot, and
# consulted by every guest-reachable fs entry point in dos/dosexec.c,
# exec/win16api.c and exec/ne.c. An unarmed slot DENIES.
# ---------------------------------------------------------------------------
guestfs_arm_rs
guestfs_disarm_rs
guestfs_cred_rs
guestfs_stats_rs
guestfs_check_rs
guestfs_selftest_rs

# ---------------------------------------------------------------------------
# rustkern/sshdcfg.rs - #697: whether sshd listens at all, which accounts may
# authenticate, and which public keys authorize which account. The file I/O and
# the credential check itself stay in C (fat_read_file, users_authenticate);
# the PARSERS and the allow/deny DECISION live here. Absent config means the
# listener does not start, which is what makes the remote-root class dead
# rather than merely fixed.
# ---------------------------------------------------------------------------
sshd_cfg_parse_rs
sshd_user_allowed_rs
sshd_authkey_match_rs
sshd_cfg_selftest_rs
# #785: renders the policy back to canonical /CONFIG/SSHD.CFG text so the
# service manager can PERSIST enable/disable. The renderer sits next to the
# parser, in the same language, so there is one understanding of this format;
# a C serializer would have been a second one, and two implementations of one
# format is how the compiled-in credential survived review. Round trip is
# checked by sshd_cfg_selftest_rs at boot.
sshd_cfg_render_rs

