# ---------------------------------------------------------------------------
clip_set_rs
clip_get_rs
clip_len_rs
clip_selftest_rs

# ---------------------------------------------------------------------------
# rustkern/ext2.rs - #404 Phase C / #485: ext2 directory-block entry scan.
# Removed the #476 OOB-read class (unbounded on-disk rec_len/name_len).
# ---------------------------------------------------------------------------
ext2_dirblock_find_rs

# ---------------------------------------------------------------------------
# rustkern/ext2.rs - #605: ext2 directory-entry INSERT within one block (the
# WRITE twin of the scan above). Removes the #597 unsigned-underflow class
# (`slack = rec - used` wrapping to ~4e9 -> out-of-block rec_len + OOB memcpy)
# by construction: checked_sub + bounds-checked slice access, no unsafe in the
# parsing module. Live under -DRUST_EXT2_DIRADD; C kept as
# ext2_dirblock_insert_c.
# ---------------------------------------------------------------------------
ext2_bitmap_find_run_rs
ext2_lblk_map_rs
ext2_extent_selftest_rs
ext2_dirblock_insert_rs

# ---------------------------------------------------------------------------
# rustkern/ext2.rs - #746: ext2 directory-entry REPOINT within one block, the
# atomic step of a rename over an existing destination. The third member of the
# find/insert/repoint set; dirent REMOVAL is still C-only with no Rust twin.
# Live under -DRUST_EXT2_DIRREPOINT; C kept as ext2_dirblock_repoint_c and
# compared every boot by ext2_dirrepoint_rust_selftest().
# ---------------------------------------------------------------------------
ext2_dirblock_repoint_rs

# rustkern/ext2fsck.rs - #610: the read-only ext2 consistency checker core.
# All parsing/arithmetic/verdicts; fs/ext2.c keeps every byte of I/O, kmalloc
# and locking. ext2_fsck_sizeof_rs feeds the C-side _Static_assert layout lock.
ext2_fsck_run_rs
ext2_fsck_sizeof_rs

