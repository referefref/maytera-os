# ---------------------------------------------------------------------------
# rustkern/dpmi.rs - #740: THE DPMI HOST CORE (INT 31h) for DOS/4GW guests.
# We do not run DOS4GW.EXE, we ARE the extender, so the only surface that has
# to exist is what the GAME calls: 0400 version; 0000/0001/0002/0003 and
# 0006/0007/0008/0009/000A descriptors; 0100/0101 DOS memory (a THIN WRAPPER
# over the existing INT 21h AH=48h MCB allocator, never a second one); and
# 0600/0601 lock/unlock, which are tier 1 because Doom locks its entire image
# at startup and a CF=1 there aborts it. 0300/0301/0302 attach through
# dpmi_set_ext_rs. Every other AX is a LOGGED MISS returning CF=1/AX=0x8001,
# never an untouched register file.
# ---------------------------------------------------------------------------
dpmi_int31_rs
dpmi_rmvec_seed_rs
dpmi_host_reset_rs
dpmi_bind_dosmem_rs
dpmi_set_ext_rs
dpmi_bind_arena_rs
dpmi_bind_meminfo_rs
dpmi_seed_desc_rs
dpmi_sel_lookup_rs
dpmi_report_rs
dpmi_selftest_rs
guestfs_selftest_rs

