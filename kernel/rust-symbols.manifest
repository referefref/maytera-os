# ---------------------------------------------------------------------------
# rustkern/seccore.rs - #624 CPU security core. Owns the CPUID feature decode
# (bounds-checked against the max supported leaf, which the C it replaces did
# NOT do), the SMEP/SMAP enable POLICY, the CR4 readback verification, and the
# live feature bitmask. C keeps only sec_cr4_read/sec_cr4_write, an irreducible
# privileged-instruction pair.
# ---------------------------------------------------------------------------
sec_cpu_has_smep_rs
