# rustkern/x86_32.rs - #740: the 32-bit protected-mode guest execution core
# (DOS/4GW). Owner: kernel/exec/x86_32.h + exec/x86_32_test.c, and, when it
# lands, the DPMI host. These are NOT behind a -DRUST_* strangler flag: there is
# no C predecessor to strangle, so the link IS the backstop for x86_32_run, but
# not for the other four, which only the oracle self-test calls today.
x86_32_run
x86_32_init
x86_32_cpu_size
x86_32_read_guest
x86_32_write_guest
# M4: asynchronous interrupt delivery INTO the guest (the events-IN direction).
# Called only from dos/dosexec.c dos4gw_timebase(), at the instruction boundary
# x86_32_run() returns on. Its return path is IRETD in the same core.
x86_32_inject_int
# (#740 digplay) a far CALL into the guest, for an INT 33h 0Ch/14h mouse event
# handler installed by a NATIVE protected-mode INT 33h. It returns with RETF,
# not IRET, so it cannot be delivered through x86_32_inject_int's gate frame.
# Called only from dos/dosexec.c dos4gw_mouse_events().
x86_32_inject_farcall
# #740 doom-present: the VGA-aperture memory hook this core did not have.
# Without it, a DOS/4GW guest's writes into an unchained (Mode X) framebuffer
# landed as flat stores into the shared `mem` arena and never reached the
# per-plane storage dos_present_modex() reads, presenting a permanently
# zero-filled flat colour for every Mode X DOS/4GW title. Called once from
# dos/dosexec.c right after x86_32_init() when a 4GW module is loaded.
x86_32_set_mem_hook
x86_32_set_sel_base_cb
x86_32_set_low_watch

# (#rafault) The branch trace. Owner: kernel/exec/x86_32.h + dos/dosexec.c's
# dos4gw_dump_derail(). Armed only under /CONFIG/DOSDIAG.CFG; a diagnostic, not
# a shipped feature, and the golden never calls x86_32_btrace(1, ...).
x86_32_btrace
x86_32_btrace_on
x86_32_btrace_dump

# ---------------------------------------------------------------------------
# rustkern/x87.rs (#211) - the x87 EXECUTION UNIT for the 32-bit guest core.
# The numeric results all come from exec/softfpu.c, which is the SAME
# arithmetic the Win16 layer's software x87 uses; this module owns the
# register stack, the control/status words and the encodings.
#
# Only the self-test is exported. The unit itself is called from
# rustkern/x86_32.rs's D8..DF arm, i.e. Rust to Rust, so there is nothing for
# a C extern to get wrong. Owner of the export: kernel/exec/x86_32.h, driven
# from dos/dos4gw.c's boot self-test report.
# ---------------------------------------------------------------------------
x87_selftest_rs


# rustkern/vbe.rs - #740: VESA BIOS Extensions (VBE 1.2) for the DOS guest.
# The mode table, the two spec-defined structure layouts, the guest-visible
# video-BIOS ROM blob and the whole INT 10h AH=4Fh dispatcher. Callers: the
# glue in dos/dosexec.c (int10() case 0x4F, dos_run_file() at launch).
# Banked at A000:0000 only, no linear framebuffer: see the module header and
# docs/VESA_VIDEO_DESIGN.md F1 for why an LFB is UNREACHABLE, not merely slow.
vbe_build_rom_rs
vbe_dispatch_rs
vbe_selftest_rs
vbe_vram_bytes_rs
vbe_present_rs

# ---------------------------------------------------------------------------
# rustkern/cga.rs (#212) - the CGA GRAPHICS presenter, modes 04h/05h/06h.
# Owner: the marshalling in dos/dosexec.c (dos_present_cga, called from
# dos_present_inner) and the mode-set / AH=0Bh / port-0x3D9 arms beside it.
#
# It exists because dos_present_inner() had arms for VESA, text, EGA planar
# and mode 13h ONLY, so every CGA graphics mode fell off the end of
# "if (t->video_mode != 0x13) return;" and drew NOTHING: the window kept the
# compositor's uniform grey. /DOS/JOUST/JOUST.COM sets mode 04h as its first
# act, which is the whole of #212.
cga_present_rs
cga_selftest_rs
# ---------------------------------------------------------------------------
# rustkern/dos4gw.rs (#740) - THE REGISTER-FRAME BRIDGE for a 32-bit DOS/4GW
# guest: the answer to rustkern/x86_32.rs's X32_EXIT_INT. Owner:
# kernel/dos/dos4gw.{c,h} and the dos_run_le() path in kernel/dos/dosexec.c.
#
# New logic with no C predecessor, so no _c twin and no -DRUST_* strangler
# flag; the link is not the backstop either, because the whole point of this
# module is that it RUNS: dos4gw_selftest_rs is driven at every boot and
# dos4gw_report_rs prints the MISS histogram of a real guest.
#
# The state object is OPAQUE to C (it allocates dos4gw_state_size_rs() bytes
# and never reads a field), so this manifest is the entire declared surface;
# there is no #[repr(C)] mirror to drift and no _Static_assert set.
# ---------------------------------------------------------------------------
dos4gw_state_size_rs
dos4gw_xfer_max_rs
dos4gw_init_rs
dos4gw_int21_pre_rs
dos4gw_int21_post_rs
dos4gw_int_pre_rs
