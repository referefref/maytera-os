# rustkern/bklsite.rs - #118: per-CALL-SITE Big Kernel Lock hold accounting.
# The [SCHEDCORE] "maxhold=...@0xNNN" reason tag is read at RELEASE from a
# per-cpu variable that every ISR and syscall ENTRY overwrites, so for any hold
# longer than one 4 ms timer period it names the last interrupt to fire, not the
# holder. These key the accounting on the depth-0 acquire return address
# instead, which does name the holder. State is in cpu/smp.c because it is
# written with interrupts masked inside the release path; the ranking decisions
# are here, the same split as schedwatch.rs and tickwatch.rs.
bklsite_add
bklsite_top

# rustkern/scprof.rs - #121: per-SYSCALL time census and read-path phase
# attribution. bklsite (above) keys on the depth-0 acquire return address,
# which names proc/syscall.asm:89 - the doorway EVERY syscall in the kernel
# goes through - and so can never say which syscall, or what it was doing.
# These key on the syscall NUMBER, and record for the worst call of each how
# many interrupt entries happened during it and how many times the BKL hold was
# broken by a context switch. State is in cpu/scprof.c (per-cpu storage plus
# the probe brackets in the dispatch and block paths); the slot, merge, ranking
# and self-check decisions are here, the same split as bklsite.rs.
scprof_add
scprof_top
scprof_selfcheck

# rustkern/schedwatch.rs - #67 SMP scheduler livelock diagnostic + run-queue
# placement policy. sched_storm_verdict_rs is the ONLY one of these that runs on
# every build regardless of g_smp_user_sched: it is the context-switch storm
# detector, and the failure it exists to catch is a SILENT wedge.
sched_storm_verdict_rs
sched_place_rs
sched_steal_rs
sched_core_pct_rs
sched_watch_selftest_rs

# rustkern/cpuobs.rs - #83: "which core is this task on", made answerable.
# process_t::running_cpu had exactly ONE writer (the end of sched_rq_pop) and no
# invalidator anywhere, so it recorded "which core last picked this up" and then
# said it for ever - for tasks that were since blocked, sleeping, or running
# elsewhere. proc/process.h now splits it into a live running_cpu (published at
# the switch, cleared for the outgoing task) and a sticky last_cpu (the
# placement hint, which is what the merged field was really computing).
# These own the ACCOUNTING and the VERDICTS over caller-built snapshots; the two
# stores stay in C next to the switch asm, the same split as schedwatch.rs.
# sched_cpuobs_note_rs runs on EVERY context switch on every build.
sched_cpuobs_note_rs
sched_cpuobs_distinct_rs
sched_cpuobs_migrations_rs
sched_cpuobs_switchins_rs
sched_cpuobs_drops_rs
sched_cpuobs_last_mig_rs
sched_cpuobs_live_verdict_rs
sched_cpuobs_selftest_rs

# rustkern/rqlock.rs - #143 part 2: is the run-queue lock the bottleneck?
# Judges one ~4s reporting window of the counters C collects at the lock.
# The counters are incremented in C because they sit on the scheduler hot
# path with interrupts masked; only the arithmetic is here. Called once per
# window from sched_smp_report(), never on the hot path.
rqlock_verdict_rs
rqlock_contended_pct_rs
rqlock_held_pct_rs
rqlock_selftest_rs

# rustkern/bklstat.rs - #166: the BKL's per-window deltas and the invariants
# that say when they are lying. The counter STORES stay in C (hot, asm-bracketed
# bkl_take_locked path); this is the once-per-4s arithmetic that was wrong.
bkl_window_rs
bkl_window_bad_rs
bkl_stat_selftest_rs

# rustkern/hdadma.rs - #71: did the HD Audio output stream DMA engine actually
# RUN while a sound was supposed to come out? A single LPIB read cannot tell
# "stopped" from "we looked at the wrong moment", which is exactly how build
# 1932s AUDIOLOG produced a RUN=0/LPIB=0 snapshot taken before the tone had
# played and three theories were built on it. These are pure functions over a
# two-read delta plus elapsed REAL time (mono_us, never timer_ticks); the MMIO
# reads and the sleep live in drivers/hda.c.
hda_dma_bytes_advanced_rs
hda_dma_expected_bytes_rs
hda_dma_bytes_per_sec_rs
hda_dma_rate_permille_rs
hda_dma_verdict_rs
hda_dma_verdict_name_rs
# -------------------------------------------------------------------- sinkown
# #205 pass 2: the PCM mixer is now the only legitimate opener of the ONE
# hardware output stream, because every other producer pushes into it. These
# make that IMPOSSIBLE TO BREAK rather than merely true today: audio_open()
# claims the sink and a second caller is refused a stream at all, so it has
# nothing to write through. Same shape as fbown.rs/fetchown.rs/blkstage.rs.
# Pure state machine over one token, no allocation, no MMIO, no dereference of
# the token it is given.
sink_claim_rs
sink_release_rs
sink_is_owner_rs
sink_owner_rs
sink_stats_rs
sink_selftest_rs
# --------------------------------------------------------------------- pcmmix
# #205: drivers/audio_pcm.c used to serve ONE producer, so /APPS/FMSYNTH holding
# the sink for a DOS session silenced /APPS/MIDIPLAY with EBUSY on the owner's
# machine. These are the arithmetic behind the mixer that replaced that: linear
# resample of one source into a shared stereo accumulator, and a SATURATING
# clamp back down to S16 (a wrap would turn two loud producers into white
# noise). Integer only, as the kernel target requires. No rings, no locks, no
# allocation; audio_pcm.c owns all of those.
pcm_mix_add_rs
pcm_mix_finish_rs
pcm_mix_step_rs
pcm_mix_selftest_rs
# ---------------------------------------------------------------------- pcmeq
# #231r: the 5-band graphic equaliser's ACTUAL per-band DSP, and the reason the
# tray control is allowed to exist again. #231 (8a5fcee5) deleted the previous
# EQ because its faders "write a static int g_eq[5] that only the fader itself
# reads - no EQ syscall exists and it is not even persisted". These are the
# missing half: five cascaded fixed-point RBJ biquads per channel (Q28
# coefficients, Q24 design intermediates, TDF2 state in i64), applied POST-MIX
# to audio_pcm.c's summed accumulator, i.e. a master EQ. Integer only, as the
# kernel's soft-float/-mno-sse target requires. A flat EQ is BYPASSED, so the
# EQ-disabled path stays bit-identical. No rings, no locks, no allocation.
# pcm_eq_selftest_rs is a real per-band SPECTRAL measurement (5x5 matrix in
# tenths of a dB, printed to /AUDIOLOG.TXT every boot), not a plumbing check,
# because "the fader moved" is exactly the evidence #231 rejected.
pcm_eq_process_rs
pcm_eq_session_start_rs
pcm_eq_set_rs
pcm_eq_get_rs
pcm_eq_bands_rs
pcm_eq_freq_rs
pcm_eq_db10_rs
pcm_eq_active_rs
pcm_eq_reset_rs
pcm_eq_frames_rs
pcm_eq_peak_state_rs
pcm_eq_selftest_rs
pcm_eq_bench_rs
# ------------------------------------------------------------------ hdastarve
# #189: an HDA output stream replays its BDL forever once RUN is set, so a
# producer that stops feeding leaves its last ring lap looping (measured: 0.743
# s repeating for 60+ s). These decide which slots the DMA has finished, how
# many the producer may claim, and prove the silencer's window and the
# producer's window can never alias after the modulo. Free-running slot
# counters, no floats, no allocation; the memset/memcpy and MMIO are in
# drivers/hda.c.
hda_starve_advance_rs
hda_starve_zero_count_rs
hda_starve_sil_floor_rs
hda_starve_resync_rs
hda_starve_avail_slots_rs
hda_starve_selftest_rs
# AUDLEAD: starvation ACCOUNTING, split from the repair path above. resync_rs
# already knew the producer had run dry every single time it fired, and said
# nothing, so the only report anyone could make was "it sounds stuttery".
# deficit_rs is the magnitude of exactly what resync_rs is about to repair;
# lead_rs is the healthy buffer depth measured against LPIB rather than against
# a tick counter that stops being a wall clock precisely when the machine is
# too busy. Pure functions over the same two counters, no MMIO, no allocation.
hda_starve_deficit_rs
hda_starve_lead_rs
hda_starve_stat_selftest_rs
# #173: the question one step earlier than the DMA verdict. Did the RUN
# bit actually get set, and if not, was it a stale playing-shadow (the
# real iMac14,4 fault: the driver believed the stream was already running
# over an engine something else had stopped) or a controller that refused
# the write? Pure logic over the SDnCTL reads bracketing the write.
hda_start_verdict_rs
hda_start_verdict_lpib_rs
hda_start_verdict_name_rs

# rustkern/tickwatch.rs - #745 (#62): is the periodic tick actually being
# DELIVERED? Every timer in this OS is downstream of one interrupt (the 8254
# PIT on IRQ0, vector 32), nothing measured whether it arrives, and on the
# owner's iMac14,4 the evidence says it sometimes does not. These are pure
# decision functions; the port/MMIO access and the state are in cpu/tickwatch.c.
# The verdict function deliberately takes elapsed REAL time as a separate
# argument: timer_ticks is the counter under test and can never be its own
# reference.
tick_health_verdict_rs
tick_permille_rs
tick_synth_decide_rs
tick_watch_selftest_rs

# ---------------------------------------------------------------------------
# rustkern/seccore.rs - #624 CPU security core. Owns the CPUID feature decode
# (bounds-checked against the max supported leaf, which the C it replaces did
# NOT do), the SMEP/SMAP enable POLICY, the CR4 readback verification, and the
# live feature bitmask. C keeps only sec_cr4_read/sec_cr4_write, an irreducible
# privileged-instruction pair.
# ---------------------------------------------------------------------------
sec_cpu_has_smep_rs
sec_cpu_has_smap_rs
sec_cpu_has_nx_rs
sec_cpu_has_rdrand_rs
sec_cpu_has_rdseed_rs
sec_features_rs
sec_rdtsc_rs
sec_init_rs
sec_entropy_source_rs
sec_random_u64_rs
sec_canary_generate_rs
sec_mark_canary_live_rs

# ---------------------------------------------------------------------------
# rustkern.rs - #653 security event record formatting. Owns the pure half of
# the security event sink: severity classification, event naming, and encoding
# one audit record into a caller-supplied buffer. Every write is bounds-checked
# against that buffer, which matters because the detail text can originate from
# an event triggered by hostile input. The worker that performs the actual
# filesystem writes stays in C (security/seclog.c) because it is entangled with
# the C wait-queue, VFS and thread-creation APIs.
# ---------------------------------------------------------------------------
sec_fmt_record
sec_event_severity
sec_event_name

# ---------------------------------------------------------------------------
# rustkern/gfsjournal.rs - #711 GraphFS tamper-evident journal (slice 1). Owns
# the record format, the SHA-256 hash chain, the seal, and ALL verification.
# Verification is the code an attacker gets to feed (a tampered journal is
# hostile input by definition), so it lives in the memory-safe language and
# every read goes through a slice over an exactly-known extent. The I/O and
# lifecycle glue stays in C (fs/graphfs/journal.c) because wait_event,
# proc_create_ex and the fat/ext2 file APIs are C with no Rust bindings here.
# ---------------------------------------------------------------------------
gfsj_encode
gfsj_seal_encode
gfsj_seal_bootgen
gfsj_verify
gfsj_sizes

# ---------------------------------------------------------------------------
# rustkern/gfsfold.rs (#711 slice 2) - the FOLD: the in-memory graph that IS a
# fold of the journal record stream. Owns the graph payload layouts, the escrow
# rule and the Q1 enforcement check. Nothing else in the kernel holds graph
# state.
# ---------------------------------------------------------------------------
gfsf_apply
gfsf_grant_check
gfsf_edges
gfsf_nodes
gfsf_node_state
gfsf_stats
gfsf_reset
gfsf_set_ready
gfsf_set_degraded
gfsf_sizes
gfsf_prerec
gfsf_enc_node_create
gfsf_enc_node_state
gfsf_enc_edge_add
gfsf_enc_edge_revoke

# ---------------------------------------------------------------------------
# rustkern/iso9660.rs - #196 ISO 9660 (+ Joliet) parsing. These three functions
# interpret bytes off a CD image the user supplied, so every field they read
# (record length, extent length, name length, the name bytes) is
# attacker-controlled. This tree has shipped three heap over-reads in C parsers
# of exactly this shape (#476 ext2 dirent, #490 FAT LFN, #597), which is why the
# parse layer is Rust while the I/O plumbing under it (dos/imgfile.c) stays C.
# The C references are kept as iso_*_c in dos/diskimg.c for rollback and for the
# boot differential; -DRUST_ISO9660 selects which arm the live symbols call.
# ---------------------------------------------------------------------------
iso_vd_parse_rs
iso_dirrec_at_rs
iso_name_decode_rs
# #184: a well-formed volume descriptor is not the same fact as a present disc.
# These two answer "is what the descriptor points at actually in the file", which
# iso_vd_parse_rs deliberately does not (it only sees one sector). New code, so
# Rust-only with no C twin and nothing in the boot differential to compare.
iso_root_within_rs
iso_vd_declared_bytes_rs

# ---------------------------------------------------------------------------
# rustkern/certname.rs - #tls-certfix. X.509 subjectAltName parsing (length
# delimited), RFC 6125 hostname matching, keyUsage/extendedKeyUsage parsing,
# and the single chain policy chokepoint that enforces usage and
# pathLenConstraint. New code, no C twin, no -DRUST_* fallback: a second and
# weaker way to decide whether a certificate authorises a hostname is exactly
# what this removed. Proven red-then-green by tools/tls-cert-harness.
# ---------------------------------------------------------------------------
cert_hostname_match_rs
cert_san_parse_rs
cert_ku_parse_rs
cert_eku_parse_rs
cert_chain_policy_rs

# ---------------------------------------------------------------------------
# rustkern/tls_suite.rs - #tls-suitefix. The client's offered cipher suite list
# has ONE definition here, read by both the ClientHello builder and the
# ServerHello acceptance check, so the offer and the check cannot drift apart.
# tls_suite_was_offered_rs has no C caller today and is part of the module API;
# do not remove it to satisfy a linker.
# ---------------------------------------------------------------------------
tls_suite_offered_count_rs
tls_suite_offered_at_rs
tls_suite_was_offered_rs
tls13_suite_acceptable_rs

# rustkern/drvmap.rs - #739 / #196 layer 4: the drive-letter policy for mounted
# disk images. Which class a letter is, which letter a new image gets, what
# MSCDEX reports, and whether a Ring-3 caller's image path is even a path.
# dos/diskimg.c, dos/dospath.c and dos/dosexec.c all derive their answers from
# these; do not let a caller start hardcoding a letter again.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# rustkern/pwpolicy.rs - password strength policy + breached-password
# rejection. Owner: proc/users.c (the one chokepoint every password-setting
# path reaches), with proc/syscall.c, gui/login.c and main.c as callers.
#
# The DECISION (is this password acceptable?) is here; the C side owns only
# the shadow table and the hashing. pwbreach.bin, the sorted truncated-hash
# table, is include_bytes!'d by this module, so losing these exports would
# take the breach check with it and the link would NOT complain: every caller
# goes through users_password_check(), which is C.
# ---------------------------------------------------------------------------
pw_policy_check_rs
pw_policy_info_rs
pwpolicy_selftest_rs

