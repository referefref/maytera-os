early_fb_banner_refresh
early_fb_page

# rustkern/fltrec.rs - #ASUSDIAG the raw-LBA boot flight recorder. Record layout,
# ring bookkeeping and CRC32 for breadcrumbs written to the GPT alignment gap
# (LBA 34..2046) of the boot medium, which no filesystem owns. Needs no mount, so
# it survives exactly the failure that leaves /BOOTLOG.TXT unwritten. C glue and
# the block I/O are in fs/fltrec.c; this half is Rust because the dirty-sector
# arithmetic is where the off-by-one lives.
fltrec_crc32_rs
fltrec_sb_encode_rs
fltrec_sb_decode_rs
fltrec_hdr_encode_rs
fltrec_hdr_decode_rs
fltrec_append_rs
fltrec_dirty_rs
fltrec_gpt_geom_rs
fltrec_parr_scan_rs
fltrec_selftest_rs

