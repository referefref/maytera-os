sec_mark_canary_live_rs

# ---------------------------------------------------------------------------
# rustkern.rs - #653 security event record formatting. Owns the pure half of
# the security event sink: severity classification, event naming, and encoding
# one audit record into a caller-supplied buffer. Every write is bounds-checked
# against that buffer, which matters because the detail text can originate from
# an event triggered by hostile input. The worker that performs the actual
# filesystem writes stays in C (security/seclog.c) because it is entangled with
# the C wait-queue, VFS and thread-creation APIs.
# ---------------------------------------------------------------------------
sec_fmt_record
sec_event_severity
sec_event_name

# ---------------------------------------------------------------------------
# rustkern/gfsjournal.rs - #711 GraphFS tamper-evident journal (slice 1). Owns
# the record format, the SHA-256 hash chain, the seal, and ALL verification.
# Verification is the code an attacker gets to feed (a tampered journal is
# hostile input by definition), so it lives in the memory-safe language and
# every read goes through a slice over an exactly-known extent. The I/O and
# lifecycle glue stays in C (fs/graphfs/journal.c) because wait_event,
# proc_create_ex and the fat/ext2 file APIs are C with no Rust bindings here.
# ---------------------------------------------------------------------------
gfsj_encode
gfsj_seal_encode
gfsj_seal_bootgen
gfsj_verify
gfsj_sizes

# ---------------------------------------------------------------------------
# rustkern/gfsfold.rs (#711 slice 2) - the FOLD: the in-memory graph that IS a
# fold of the journal record stream. Owns the graph payload layouts, the escrow
# rule and the Q1 enforcement check. Nothing else in the kernel holds graph
# state.
# ---------------------------------------------------------------------------
gfsf_apply
gfsf_grant_check
gfsf_edges
gfsf_nodes
gfsf_node_state
gfsf_stats
gfsf_reset
gfsf_set_ready
gfsf_set_degraded
gfsf_sizes
gfsf_prerec
gfsf_enc_node_create
gfsf_enc_node_state
gfsf_enc_edge_add
gfsf_enc_edge_revoke

# ---------------------------------------------------------------------------
# rustkern/iso9660.rs - #196 ISO 9660 (+ Joliet) parsing. These three functions
# interpret bytes off a CD image the user supplied, so every field they read
# (record length, extent length, name length, the name bytes) is
# attacker-controlled. This tree has shipped three heap over-reads in C parsers
# of exactly this shape (#476 ext2 dirent, #490 FAT LFN, #597), which is why the
# parse layer is Rust while the I/O plumbing under it (dos/imgfile.c) stays C.
# The C references are kept as iso_*_c in dos/diskimg.c for rollback and for the
# boot differential; -DRUST_ISO9660 selects which arm the live symbols call.
# ---------------------------------------------------------------------------
iso_vd_parse_rs
iso_dirrec_at_rs
iso_name_decode_rs

# ---------------------------------------------------------------------------
# rustkern/certname.rs - #tls-certfix. X.509 subjectAltName parsing (length
# delimited), RFC 6125 hostname matching, keyUsage/extendedKeyUsage parsing,
# and the single chain policy chokepoint that enforces usage and
# pathLenConstraint. New code, no C twin, no -DRUST_* fallback: a second and
# weaker way to decide whether a certificate authorises a hostname is exactly
# what this removed. Proven red-then-green by tools/tls-cert-harness.
# ---------------------------------------------------------------------------
cert_hostname_match_rs
cert_san_parse_rs
cert_ku_parse_rs
cert_eku_parse_rs
cert_chain_policy_rs

# ---------------------------------------------------------------------------
# rustkern/tls_suite.rs - #tls-suitefix. The client's offered cipher suite list
# has ONE definition here, read by both the ClientHello builder and the
# ServerHello acceptance check, so the offer and the check cannot drift apart.
# tls_suite_was_offered_rs has no C caller today and is part of the module API;
# do not remove it to satisfy a linker.
# ---------------------------------------------------------------------------
tls_suite_offered_count_rs
tls_suite_offered_at_rs
tls_suite_was_offered_rs
tls13_suite_acceptable_rs

# rustkern/drvmap.rs - #739 / #196 layer 4: the drive-letter policy for mounted
# disk images. Which class a letter is, which letter a new image gets, what
# MSCDEX reports, and whether a Ring-3 caller's image path is even a path.
# dos/diskimg.c, dos/dospath.c and dos/dosexec.c all derive their answers from
# these; do not let a caller start hardcoding a letter again.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# rustkern/pwpolicy.rs - password strength policy + breached-password
# rejection. Owner: proc/users.c (the one chokepoint every password-setting
# path reaches), with proc/syscall.c, gui/login.c and main.c as callers.
#
# The DECISION (is this password acceptable?) is here; the C side owns only
# the shadow table and the hashing. pwbreach.bin, the sorted truncated-hash
# table, is include_bytes!'d by this module, so losing these exports would
# take the breach check with it and the link would NOT complain: every caller
# goes through users_password_check(), which is C.
# ---------------------------------------------------------------------------
pw_policy_check_rs
pw_policy_info_rs
pwpolicy_selftest_rs

# ---------------------------------------------------------------------------
# rustkern/hidmap.rs - #763: HID usage -> PS/2 set-1 scancode translation
hid_usage_to_set1_rs
hidmap_selftest_rs

