pollsys_selftest_rs

# rustkern/winbuf.rs - #137: how big a window content buffer may be, and how
# many bytes it needs. Owner: proc/syscall.c (sys_win_create, win16_host_create,
# the nochrome-panel path, sys_win_blit growth, sys_win_draw_image). Before this
# the size came from an unvalidated Ring-3 int multiply.
winbuf_bytes_rs
winbuf_geom_ok_rs
# #221: one window's WINDOW_FLAG_* -> the stable WIN_STATE_* bitmask its own
# process sees through SYS_WIN_GET_STATE.
winstate_bits_rs

# rustkern/winblit.rs - #blitguard: the geometry contract of sys_win_blit().
# NEW code, so there is no <fn>_c twin and no -DRUST_* strangler flag.
# Owner: proc/syscall.c (sys_win_blit). winblit_plan_rs decides the whole blit
# before a user byte is touched: it REFUSES src_w/src_h < 1 (src_h == 0 drove
# the source row index to -1, reading up to 256 KiB BELOW an attacker-named
# pointer, while making the #503 argtab length compute ZERO so the choke point
# skipped the range entirely), and CLAMPS the destination to the content buffer
# that actually exists (a failed grow used to run the write loop off the end of
# a kernel heap allocation). winblit_scale_row_rs is the nearest-neighbour inner
# loop, which never sees a user pointer: the caller bounces each source row
# through copy_from_user first.
winblit_plan_rs
winblit_scale_row_rs

# rustkern/le.rs - #740: LE (Linear Executable) parse, relocate and load for
# DOS/4GW. NEW code, so there is no `<fn>_c` twin and no -DRUST_LE flag: the
# whole parser is Rust and the C in exec/le.c only does file I/O and printing.
# The reference implementation is the HOST harness tools/le-harness/le.c.
# Owner: kernel/exec/le.c (le_info_dump, le_load_test, le_boot_selftest).
# The input is a downloaded game binary and is treated as hostile: every read
# is Option-returning, because a panicking index here HALTS THE CPU.
le_strerror_rs
le_find_rs

