button_bg_hover=0x00d0d0d0
button_bg_pressed=0x00b0b0b0
button_border=0x00a0a0a0
button_text=0x00000000
button_disabled=0x00a0a0a0
label_text=0x00000000
textbox_bg=0x00ffffff
textbox_border=0x00b0b0b0
textbox_text=0x00000000
textbox_cursor=0x00000000
checkbox_bg=0x00ffffff
checkbox_border=0x00a0a0a0
checkbox_check=0x00000000
desktop_bg=0x00e8f0f8
taskbar_bg=0x00f5f5f5
taskbar_hover=0x00e0e0e0
taskbar_active=0x00d0d0d0
start_button=0x00ffffff
gauge_bg=0x00e0e0e0
gauge_fg=0x00808080
menu_bg=0x00ffffff
menu_border=0x00c0c0c0
menu_item_hover=0x00d0e8ff
menu_text=0x00000000
menu_text_disabled=0x00909090
menu_separator=0x00e0e0e0
scrollbar_bg=0x00f0f0f0
scrollbar_thumb=0x00c0c0c0
scrollbar_thumb_hover=0x00a0a0a0
selection_bg=0x000078d7
selection_text=0x00ffffff
color_error=0x00dd0000
color_warning=0x00dd8800
color_success=0x00008800
color_info=0x000066cc
link_color=0x000066cc
link_visited=0x00660099
link_hover=0x000088ff
